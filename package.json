{
  "name": "@vima-tech/pact",
  "version": "1.0.0",
  "type": "module",
  "description": "[ARCHIVED] Superseded by https://github.com/vima-tech/vima-cli — PACT control platform for AI Agent delivery of production-ready business systems",
  "license": "MIT",
  "bin": {
    "pact": "bin/pact.mjs",
    "vima-pact": "bin/pact.mjs"
  },
  "files": [
    "bin/**",
    "docs/**",
    "pact/**",
    "pact-change/**",
    "pact-check/**",
    "pact-estimate/**",
    "pact-install/**",
    "pact-list/**",
    "pact-new/**",
    "pact-review/**",
    "pact-run/**",
    "platform/adapters/**",
    "platform/lib/**",
    "platform/registry/**",
    "platform/schemas/**",
    "platform/scripts/capability-router.mjs",
    "platform/scripts/governance-check.mjs",
    "platform/scripts/preinstall.mjs",
    "platform/scripts/postinstall.mjs",
    "platform/scripts/preuninstall.mjs",
    "install-manifest.json",
    "CLAUDE.md"
  ],
  "scripts": {
    "preinstall": "node platform/scripts/preinstall.mjs",
    "postinstall": "node platform/scripts/postinstall.mjs",
    "preuninstall": "node platform/scripts/preuninstall.mjs",
    "test": "node --test platform/test/*.test.mjs",
    "governance:check": "node platform/scripts/governance-check.mjs",
    "platform:inspect": "node platform/scripts/capability-router.mjs",
    "migration:plan": "node platform/scripts/migration.mjs plan",
    "migration:apply": "node platform/scripts/migration.mjs apply",
    "migration:verify": "node platform/scripts/migration.mjs verify",
    "bootstrap": "node platform/scripts/bootstrap.mjs",
    "verify:products": "node platform/scripts/verify-products.mjs",
    "release:plan": "node platform/scripts/release-plan.mjs",
    "release:pack": "node platform/scripts/release-pack.mjs",
    "release:verify": "node platform/scripts/verify-archives.mjs",
    "verify": "node platform/scripts/verify-all.mjs"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "devDependencies": {
    "skills": "1.5.22"
  }
}
