{
  "name": "@vima-tech/ui-admin",
  "version": "0.1.0",
  "description": "Vima UI Admin — 政企后台 Vue 3 组件库（提取自 juvenile-guard ui-v3）",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./agent/schema/app-spec.v1.json": "./dist/agent/schema/app-spec.v1.json",
    "./agent/docs/README.md": "./dist/agent/docs/README.md",
    "./agent/docs/SKILL.md": "./dist/agent/docs/SKILL.md",
    "./agent/docs/recipes/index.json": "./dist/agent/docs/recipes/index.json",
    "./agent/docs/recipes/*": "./dist/agent/docs/recipes/*",
    "./style.css": "./dist/styles/index.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./ui.css": "./dist/styles/ui.css",
    "./ai-manifest.json": "./dist/ai-manifest.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "docs": "vite --config site/vite.config.ts",
    "build:docs": "node scripts/build-api.mjs && vite build --config site/vite.config.ts",
    "build": "npm run build:lib",
    "build:lib": "node scripts/build-lib.mjs && tsc -p tsconfig.build.json",
    "build:api": "node scripts/build-api.mjs",
    "extract": "node scripts/extract-from-ui-v3.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:recipes": "npm run build:lib && node scripts/check-recipes.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:size": "node scripts/check-runtime-size.mjs",
    "check:ai": "node scripts/check-ai.mjs",
    "benchmark:ai": "npm run build:lib && node scripts/benchmark-ai.mjs",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "npm run build:lib && node --test test/*.test.mjs",
    "verify:publish": "npm run check:ai",
    "prepack": "npm run verify:publish"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue": "^3.4.21"
  },
  "dependencies": {
    "csstype": "^3.2.3",
    "entities": "^7.0.1",
    "esbuild": "^0.21.5",
    "estree-walker": "^2.0.2",
    "magic-string": "^0.30.21",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.26",
    "rollup": "^4.62.4",
    "source-map-js": "^1.2.1"
  },
  "keywords": [],
  "author": ""
}
