      "expected": { "ok": false, "codes": ["UNKNOWN_EVENT_TYPE", "UNKNOWN_EVENT_ACTION", "UNKNOWN_API_METHOD"] },
      "acceptance": ["结构化诊断分别指向事件类型、动作和请求方法"]
